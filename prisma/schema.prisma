generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  password         String
  role             String       @default("USER") // "USER" | "ADMIN"
  avatar           String?
  totalStreams     Int          @default(0)
  royaltyBalance   Float        @default(0)
  royaltyPending   Float        @default(0)
  totalWithdrawn   Float        @default(0)
  pendingWithdraw  Float        @default(0)
  createdAt        DateTime     @default(now())
  releases         Release[]
  withdrawals      Withdrawal[]
  artists          Artist[]
  receivedMessages Message[]    @relation("UserMessages")
}

model Message {
  id        String   @id @default(cuid())
  title     String
  content   String
  sender    String   @default("Admin HERMES")
  userId    String?  // null means sent to ALL users
  user      User?    @relation("UserMessages", fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Release {
  id          String   @id @default(cuid())
  title       String
  artist      String
  featuring   String   @default("")
  composer    String   @default("Abdul • HERMES")
  producer    String   @default("Luxoa Studio")
  tiktokClip  String   @default("00:45 - 01:15 (30s)")
  genre       String
  releaseDate String
  duration    String   @default("3:42")
  streams     String   @default("0")
  streamsNum  Int      @default(0)
  platform    String   @default("Spotify")
  platforms   String   @default("Spotify,Apple Music,TikTok,YouTube")
  status      String   @default("Pending") // "Approved" | "Pending" | "Rejected"
  coverUrl    String
  audioFile   String   @default("audio_preview_final.wav")
  upc         String   @default("")
  isrc        String   @default("")
  country     String   @default("United States")
  royaltyGrowth String @default("+12.4%")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Artist {
  id        String   @id @default(cuid())
  name      String
  genre     String   @default("Pop")
  spotifyId String   @default("")
  appleId   String   @default("")
  photoUrl  String   @default("")
  bio       String   @default("")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Withdrawal {
  id            String   @id @default(cuid())
  date          String
  amount        Float
  method        String   // e.g. "Bank • BCA", "E-Wallet • OVO", "Bank • Mandiri"
  accountNumber String
  status        String   @default("Pending") // "Approved" | "Pending" | "Rejected"
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
}

model Catalog {
  id          String   @id @default(cuid())
  songId      String   @unique
  title       String
  artist      String
  publisher   String
  status      String   @default("Aktif") // "Aktif" | "Nonaktif" | "Review"
  youtubeLink String?
  driveLink   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LandingContent {
  id               String   @id @default("default")
  heroSubtitle     String   @default("Global Reach By BREAKOUT.ID")
  heroTitle1       String   @default("BREAKOUT")
  heroTitle2       String   @default("ID")
  heroBgImage      String   @default("/6293920186406475229_121.jpg")
  navBgImage       String   @default("/header-bg.jpg")
  storesCount      Int      @default(150)
  card1Text        String   @default("We reshape the future of music distribution and artist services as a platform (MaaS).")
  card1Image       String   @default("/6293920186406475218_120.jpg")
  card2Title       String   @default("Driven By A Passion.")
  card2Desc        String   @default("Pushing the boundaries of what's possible in the global audio realm.")
  card2Image       String   @default("/6293920186406475218_120.jpg")
  card3Title       String   @default("Distribution Solutions.")
  card3Desc        String   @default("Tailored to your unique sound crafting new sonic landscapes.")
  card3Image       String   @default("/6293920186406475218_120.jpg")
  artistsJson      String   @default("[]")
  testimonialsJson String   @default("[]")
  updatedAt        DateTime @updatedAt
}

